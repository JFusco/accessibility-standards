{
  "name": "accessibility-standards",
  "version": "1.0.0",
  "description": "Versioned accessibility standards and reusable WCAG, ARIA, and HTML contracts for projects and coding agents.",
  "type": "module",
  "private": false,
  "license": "MIT",
  "author": "Joe Fusco",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JFusco/accessibility-standards.git"
  },
  "homepage": "https://github.com/JFusco/accessibility-standards#readme",
  "bugs": {
    "url": "https://github.com/JFusco/accessibility-standards/issues"
  },
  "packageManager": "pnpm@11.28.11",
  "engines": {
    "node": ">=24.14.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "accessibility-standards": "bin/accessibility-standards.mjs"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./index.json": "./dist/index.json",
    "./contracts/*": "./dist/contracts/*.json",
    "./coverage": "./dist/coverage-manifest.json",
    "./applicability": "./dist/applicability-matrix.json",
    "./ui-design-brain": "./lib/ui-design-brain.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "src",
    "schemas",
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md",
    "OPERATING.md"
  ],
  "keywords": [
    "accessibility",
    "wcag",
    "wai-aria",
    "coding-agents"
  ],
  "scripts": {
    "prepare": "husky",
    "test:packed": "node scripts/verify-packed-consumer.mjs",
    "lint:commit": "commitlint --config commitlint.config.cjs",
    "lint:pr": "node scripts/validate_pr_body.cjs",
    "release:dry": "semantic-release --dry-run",
    "release:preflight": "node scripts/check-release-commit.cjs",
    "release:preflight:selftest": "node scripts/check-release-commit.selftest.cjs",
    "wiki:check": "node scripts/wiki/check.cjs",
    "graph:build": "node scripts/wiki/build-graph.cjs",
    "graph:check": "node scripts/wiki/build-graph.cjs --check",
    "build": "node bin/accessibility-standards.mjs build",
    "validate": "node bin/accessibility-standards.mjs validate",
    "test": "node --test tests/unit/*.test.mjs",
    "prepack": "npm run build",
    "verify:ci": "pnpm release:preflight && pnpm release:preflight:selftest && pnpm validate && pnpm build && pnpm test && pnpm wiki:check && pnpm test:packed"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@semantic-release/changelog": "6.0.3",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/git": "10.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/npm": "13.2.0",
    "ajv": "8.20.0",
    "conventional-changelog-conventionalcommits": "10.4.1",
    "husky": "9.1.7",
    "semantic-release": "25.0.9",
    "ui-design-brain": "1.18.9"
  }
}
